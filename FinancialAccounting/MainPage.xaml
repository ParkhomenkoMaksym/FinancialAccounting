                SemanticProperties.Description="Welcome to dot net Multi platform App U I" />-->
    <Grid RowDefinitions ="auto, *, auto">
        <Label 
            Grid.Row="0"
            Text="Accounting"
            HorizontalOptions="Center"
            Padding="0, 10, 0, 0"/>

        <Border
            Grid.Row="1"
            Stroke="Grey"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 12"
            Padding="15"
            Margin="10">

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                RowDefinitions="auto, *"
                Margin="0">

                <Button
                    x:Name="btnExpensses"
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalOptions="Start"
                    Text="Add Expensses"
                    Margin="0,0,0,15"
                    Clicked="BtnExpensses_Clicked"/>

                <Button 
                    x:Name="btnIncome"
                    Grid.Column="1"
                    Grid.Row="0"
                    VerticalOptions="Start"
                    Text="Add Income"
                    Margin="0,0,0,15"
                    Clicked="BtnIncome_Clicked"/>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Stroke="Grey"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12"
                    Padding="5"
                    Margin="0">

                    <ScrollView>
                        <VerticalStackLayout
                            x:Name="btnExpenssesCreator"
                            Padding="10, 0"
                            Spacing="0">
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Stroke="Grey"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12"
                    Padding="5"
                    Margin="0">

                    <ScrollView>
                        <VerticalStackLayout
                            x:Name="btnIncomeCreator"
                            Padding="10, 0"
                            Spacing="0">
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>
        </Border>

        <Button
            Grid.Row="2"
            x:Name="CounterBtn"
            Text="Click me" 
            SemanticProperties.Hint="Counts the number of times you click"
            HorizontalOptions="Fill"
            Margin="10, 0, 10, 10"/>
    </Grid>

</ContentPage>
